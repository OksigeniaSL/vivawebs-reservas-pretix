msgid "Category name"
msgstr "Nombre de la categoría"

msgid "If you set this, this will be used instead of the public name in the backend."
msgstr "Si estableces esto, se usará en lugar del nombre público en el panel."

msgid "Category description"
msgstr "Descripción de la categoría"

msgid "Products in this category are add-on products"
msgstr "Los servicios de esta categoría son servicios adicionales"

msgid "If selected, the products belonging to this category are not for sale on their own. They can only be bought in combination with a product that has this category configured as a possible source for add-ons."
msgstr "Si se selecciona, los servicios de esta categoría no se pueden reservar por separado. Solo se pueden reservar junto con un servicio que tenga configurada esta categoría como posible fuente de adicionales."

msgid "Normal category"
msgstr "Categoría normal"

msgid "Normal + cross-selling category"
msgstr "Categoría normal + venta cruzada"

msgid "Cross-selling category"
msgstr "Categoría de venta cruzada"

msgid "Always show in cross-selling step"
msgstr "Mostrar siempre en la etapa de venta cruzada"

msgid "Only show products that qualify for a discount according to discount rules"
msgstr "Mostrar solo servicios que cumplan con un descuento según las reglas de descuento"

msgid "Only show if the cart contains one of the following products"
msgstr "Mostrar solo si tu selección contiene uno de los siguientes servicios"

msgid "Cross-selling condition"
msgstr "Condición de venta cruzada"

msgid "Cross-selling condition products"
msgstr "Servicios de condición de venta cruzada"

msgid "Product categories"
msgstr "Categorías de servicios"

