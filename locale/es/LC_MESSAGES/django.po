msgid "Attendee: {name}"
msgstr "Participante: {name}"

msgctxt "subevent"
msgid "Date: {}"
msgstr "Fecha: {}"

msgid "A payment provider specific text might appear here."
msgstr "Aquí podría aparecer un texto específico del proveedor de pago."

msgid "214th Example Street"
msgstr "Calle Ejemplo 214"

msgid "012345"
msgstr "012345"

msgid "Sample product {}"
msgstr "Servicio de ejemplo {}"

msgid "Sample product A"
msgstr "Servicio de ejemplo A"

msgid "New invoice: {number}"
msgstr "Nueva factura: {number}"

msgid "Hello,\n\na new invoice for order {order} at {event} has been created, see attached.\n\nWe are sending this email because you configured us to do so in your event settings."
msgstr "Hola,\n\nSe ha creado una nueva factura para la reserva {order} de {event}, la encontrarás adjunta.\n\nEstás recibiendo este correo porque así lo has configurado en los ajustes del negocio."

msgid "This prefix has been set in your event or organizer settings."
msgstr "Este prefijo se ha establecido en la configuración de tu negocio."

msgctxt "attachment_filename"
msgid "Calendar invite"
msgstr "Invitación de calendario"

msgid "You are receiving this email because someone placed an order for {event} for you."
msgstr "Recibes este correo porque alguien realizó una reserva de {event} para ti."

msgid "You can view your order details at the following URL:\n{orderurl}."
msgstr "Puedes ver los detalles de tu reserva en la siguiente URL:\n{orderurl}."

msgid "You are receiving this email because you placed an order for {event}."
msgstr "Recibes este correo porque realizaste una reserva para {event}."

msgid "Invalid medium type."
msgstr "Tipo de soporte no válido."

msgid "Medium type is not enabled for organizer."
msgstr "El tipo de soporte no está habilitado para el negocio."

msgid "Incorrect medium type for product."
msgstr "Tipo de soporte incorrecto para este servicio."

msgid "Ticket is already exchanged for reusable medium."
msgstr "La plaza ya se ha canjeado por un soporte reutilizable."

msgid "Reusable medium not found."
msgstr "No se ha encontrado el soporte reutilizable."

msgid "Reusable medium is inactive or expired."
msgstr "El soporte reutilizable está inactivo o caducado."

msgid "Reusable medium not found and could not be created."
msgstr "No se ha encontrado el soporte reutilizable y no se ha podido crear."

msgid "Reusable medium already exists."
msgstr "Ya existe un soporte reutilizable."

msgid "Reusable medium could not be created."
msgstr "No se ha podido crear el soporte reutilizable."

msgid "Product does not support medium exchange."
msgstr "Este servicio no admite el cambio de medio."

msgid "You selected a membership for the product \"{product}\" which does not require a membership."
msgstr "Has seleccionado una suscripción para el servicio \"{product}\" que no requiere suscripción."

msgid "You selected the product \"{product}\" which requires an active membership to be selected."
msgstr "Has seleccionado el servicio \"{product}\" que requiere una suscripción activa."

msgid "You selected a membership that is connected to a different customer account."
msgstr "Has seleccionado una suscripción vinculada a otra cuenta de cliente."

msgid "You selected membership that has been canceled."
msgstr "Has seleccionado una suscripción que ha sido cancelada."

msgid "You can not use a test mode membership for tickets that are not in test mode."
msgstr "No puedes usar una suscripción en modo de prueba para plazas que no estén en modo de prueba."

msgid "You need to add a test mode membership to the customer account to use it in test mode."
msgstr "Es necesario añadir una suscripción en modo de prueba a la cuenta de cliente para usarla en modo de prueba."

msgid "You selected a membership that is valid from {start} to {end}, but selected a ticket that starts to be valid on {date}."
msgstr "Has seleccionado una suscripción válida de {start} a {end}, pero has seleccionado una plaza que empieza a ser válida el {date}."

msgid "You selected a membership that is valid from {start} to {end}, but selected an event taking place at {date}."
msgstr "Has seleccionado una suscripción válida de {start} a {end}, pero la sesión tiene lugar el {date}."

msgid "You selected a membership of type \"{type}\", which is not allowed for the product \"{product}\"."
msgstr "Has seleccionado una suscripción de tipo \"{type}\", que no está permitida para el servicio \"{product}\"."

msgid "You are trying to use a membership of type \"{type}\" more than {number} times, which is the maximum amount."
msgstr "Estás intentando usar una suscripción de tipo \"{type}\" más de {number} veces, que es la cantidad máxima."

msgid "You are trying to use a membership of type \"{type}\" for a ticket valid from {valid_from} until {valid_until}, however you already used the same membership for a different ticket that overlaps with this time frame ({conflict_from} – {conflict_until})."
msgstr "Estás intentando usar una suscripción de tipo \"{type}\" para una plaza válida desde {valid_from} hasta {valid_until}, pero ya has usado la misma suscripción para otra plaza que se solapa con este periodo ({conflict_from} – {conflict_until})."

msgid "start"
msgstr "Inicio"

msgid "open end"
msgstr "Final abierto"

msgid "You are trying to use a membership of type \"{type}\" for an event taking place at {date}, however you already used the same membership for a different ticket at the same time."
msgstr "Estás intentando usar una suscripción de tipo \"{type}\" para una sesión que tendrá lugar el {date}, pero ya has usado la misma suscripción para otra plaza en el mismo momento."

msgid "Error decoding special characters in your file: {message}"
msgstr "Error al decodificar caracteres especiales en tu archivo: {message}"

msgid "Error while importing value \"{value}\" for column \"{column}\" in line \"{line}\": {message}"
msgstr "Error al importar el valor \"{value}\" para la columna \"{column}\" en la línea \"{line}\": {message}"

msgid "Orders cannot have more than %(max)s positions."
msgstr "Las reservas no pueden tener más de %(max)s posiciones."

msgid "The grouping \"%(value)s\" occurs on non-consecutive lines (seen again on line %(row)s)."
msgstr "La agrupación «%(value)s» aparece en líneas no consecutivas (vuelve a aparecer en la línea %(row)s)."

msgid "Inconsistent data in row {row}: Column {col} contains value \"{val_line}\", but for this order, the value has already been set to \"{val_order}\"."
msgstr "Datos inconsistentes en la fila {row}: La columna {col} contiene el valor «{val_line}», pero para esta reserva el valor ya se ha establecido en «{val_order}»."

msgid "Invalid data in row {row}: {message}"
msgstr "Datos no válidos en la fila {row}: {message}"

msgid "A voucher cannot be created without a code."
msgstr "No se puede crear un código sin código."

msgid "Voucher codes must be unique. Code \"{code}\" already exists in this import."
msgstr "Los códigos deben ser únicos. El código «{code}» ya existe en esta importación."

msgid "Voucher codes must be unique. Import contains existing voucher code {code}."
msgid_plural "Voucher codes must be unique. Import contains existing voucher codes {code}."
msgstr[0] "Los códigos deben ser únicos. La importación incluye el código ya existente {code}."
msgstr[1] "Los códigos deben ser únicos. La importación incluye códigos ya existentes {code}."

msgid "Vouchers could not be imported, probably due to a voucher code already being in use."
msgstr "No se han podido importar los códigos, probablemente porque ya se está usando uno de ellos."

msgid "Some of the products you selected were no longer available. Please see below for details."
msgstr "Algunos de los servicios que has seleccionado ya no estaban disponibles. Consulta los detalles más abajo."

msgid "Some of the products you selected were no longer available in the quantity you selected. Please see below for details."
msgstr "Algunos de los servicios que has seleccionado ya no estaban disponibles en la cantidad seleccionada. Consulta los detalles más abajo."

msgid "The price of some of the items in your cart has changed in the meantime. Please see below for details."
msgstr "El precio de algunos servicios de tu selección ha cambiado mientras tanto. Consulta los detalles más abajo."

msgid "An internal error occurred, please try again."
msgstr "Se ha producido un error interno, inténtalo de nuevo."

msgid "This order was changed by someone else simultaneously. Please check if your changes are still accurate and try again."
msgstr "Esta reserva fue modificada simultáneamente por otra persona. Comprueba si tus cambios siguen siendo correctos e inténtalo de nuevo."

msgid "Your cart is empty."
msgstr "Tu selección está vacía."

msgid "You cannot select more than %(max)s item of the product %(product)s. We removed the surplus items from your cart."
msgid_plural "You cannot select more than %(max)s items of the product %(product)s. We removed the surplus items from your cart."
msgstr[0] "No puedes seleccionar más de %(max)s plaza del servicio %(product)s. Hemos eliminado el exceso de tu selección."
msgstr[1] "No puedes seleccionar más de %(max)s plazas del servicio %(product)s. Hemos eliminado el exceso de tu selección."

msgid "The booking period has ended."
msgstr "El periodo de reservas ha finalizado."

msgid "The voucher code \"%(voucher)s\" can only be used if you select at least %(number)s matching products."
msgid_plural "The voucher code \"%(voucher)s\" can only be used if you select at least %(number)s matching products."
msgstr[0] "El código «%(voucher)s» solo se puede usar si seleccionas al menos %(number)s servicio coincidente."
msgstr[1] "El código «%(voucher)s» solo se puede usar si seleccionas al menos %(number)s servicios coincidentes."

msgid "The voucher code used for one of the items in your cart is not known in our database."
msgstr "El código usado para uno de los servicios de tu selección no está en nuestra base de datos."

msgid "The voucher code used for one of the items in your cart has already been used the maximum number of times allowed. We removed this item from your cart."
msgstr "El código usado para uno de los servicios de tu selección ya ha alcanzado el máximo de usos permitidos. Hemos eliminado este servicio de tu selección."

msgid "The voucher code used for one of the items in your cart has already been too often. We adjusted the price of the item in your cart."
msgstr "El código usado para uno de los servicios de tu selección ya se ha usado demasiadas veces. Hemos ajustado el precio del servicio en tu selección."

msgid "The voucher code used for one of the items in your cart is expired. We removed this item from your cart."
msgstr "El código usado para uno de los servicios de tu selección ha caducado. Hemos eliminado este servicio de tu selección."

msgid "The voucher code used for one of the items in your cart is not valid for this item. We removed this item from your cart."
msgstr "El código usado para uno de los servicios de tu selección no es válido para este servicio. Hemos eliminado este servicio de tu selección."

msgid "You need a valid voucher code to order one of the products."
msgstr "Necesitas un código válido para reservar uno de los servicios."

msgid "One of the seats in your order was invalid, we removed the position from your cart."
msgstr "Una de las plazas de tu reserva no era válida, la hemos eliminado de tu selección."

msgid "One of the seats in your order has been taken in the meantime, we removed the position from your cart."
msgstr "Una de las plazas de tu reserva ya ha sido ocupada, la hemos eliminado de tu selección."

msgid "You cannot remove the position %(addon)s since it has already been checked in."
msgstr "No puedes eliminar la posición %(addon)s porque ya se ha registrado su llegada."

msgid "Paid products not supported without a valid currency."
msgstr "No se admiten servicios de pago sin una moneda válida."

msgid "The order was not canceled."
msgstr "La reserva no fue cancelada."

msgid "The new expiry date needs to be in the future."
msgstr "La nueva fecha de caducidad debe ser en el futuro."

msgid "This order is not pending approval."
msgstr "Esta reserva no está pendiente de aprobación."

msgid "You cannot cancel this order."
msgstr "No puedes cancelar esta reserva."

msgid "This order can not be canceled since the gift card {card} purchased in this order has already been redeemed."
msgstr "Esta reserva no se puede cancelar porque la tarjeta regalo {card} adquirida en esta reserva ya se ha canjeado."

msgid "The cancellation fee cannot be higher than the total amount of this order."
msgstr "La tarifa de cancelación no puede ser superior al importe total de esta reserva."

msgid "The selected payment methods do not cover the total balance."
msgstr "Los métodos de pago seleccionados no cubren el saldo total."

msgid "While trying to place your order, we noticed that the order total has changed. Either one of the prices changed just now, or a gift card you used has been used in the meantime. Please check the prices below and try again."
msgstr "Al intentar confirmar tu reserva hemos detectado que el total ha cambiado. O bien algún precio ha cambiado o una tarjeta regalo ha sido usada mientras tanto. Comprueba los precios más abajo e inténtalo de nuevo."

msgid "You need to select a variation of the product."
msgstr "Debes seleccionar una variación del servicio."

msgid "The quota {name} does not have enough capacity left to perform the operation."
msgstr "El cupo {name} no tiene capacidad suficiente para realizar la operación."

msgid "There is no quota defined that allows this operation."
msgstr "No hay ningún cupo definido que permita esta operación."

msgid "The selected product is not active or has no price set."
msgstr "El servicio seleccionado no está activo o no tiene precio establecido."

msgid "This operation would leave the order empty. Please cancel the order itself instead."
msgstr "Esta operación dejaría la reserva vacía. Cancela la reserva completa en su lugar."

msgid "This operation would make the order free and therefore immediately paid, however no quota is available."
msgstr "Esta operación haría que la reserva fuera gratuita y por tanto se pagara inmediatamente, pero no hay cupo disponible."

msgid "This is an add-on product, please select the base position it should be added to."
msgstr "Este es un servicio adicional, selecciona la posición base a la que debe añadirse."

msgid "The selected base position does not allow you to add this product as an add-on."
msgstr "La posición base seleccionada no permite añadir este servicio como complemento."

msgid "You need to choose a subevent for the new position."
msgstr "Es necesario elegir una sesión para la nueva posición."

msgid "You selected seat \"{seat}\" for a date that does not match the selected ticket date. Please choose a seat again."
msgstr "Has seleccionado el asiento \"{seat}\" para una fecha que no coincide con la sesión seleccionada. Por favor, elige de nuevo un asiento."

msgid "The selected product requires you to select a seat."
msgstr "El servicio seleccionado requiere que selecciones un asiento."

msgid "The selected product does not allow to select a seat."
msgstr "El servicio seleccionado no permite seleccionar un asiento."

msgid "The selected country is blocked by your tax rule."
msgstr "El país seleccionado está bloqueado por la norma fiscal."

msgid "You cannot change the price of a position that has been used to issue a gift card."
msgstr "No se puede cambiar el precio de una posición que se ha usado para emitir una tarjeta regalo."

msgid "You cannot change the ticket secret of a position that has been used to issue a gift card."
msgstr "No se puede modificar el código secreto de una plaza que se ha usado para emitir una tarjeta regalo."

msgid "A position can not be canceled since the gift card {card} purchased in this order has already been redeemed."
msgstr "La posición no se puede cancelar, ya que la tarjeta regalo {card} reservada en esta reserva ya se ha canjeado."

msgid "There was an error while trying to send the money back to you. Please contact the event organizer for further information."
msgstr "Ha habido un error al intentar devolver el dinero. Por favor, contacta con el negocio para más información."

msgid "View registration details"
msgstr "Ver detalles de la inscripción"

msgid "Sample Corporation"
msgstr "Corporación de Ejemplo"

msgid "Sample Admission Ticket"
msgstr "Ejemplo de plaza"

msgid "An individual text with a reason can be inserted here."
msgstr "Aquí se puede insertar un texto personalizado con una razón."

msgid "The amount has been charged to your card."
msgstr "El importe se ha cargado a tu tarjeta."

msgid "Please transfer money to this bank account: 9999-9999-9999-9999"
msgstr "Por favor, transfiere el dinero a esta cuenta bancaria: 9999-9999-9999-9999"

msgid "This value will be replaced based on dynamic parameters."
msgstr "Este valor se reemplazará según parámetros dinámicos."

msgid "You can not change the plan since seat \"%s\" is not present in the new plan and is already sold."
msgstr "No se puede cambiar el plano, ya que el asiento \"%s\" no está presente en el nuevo plano y ya está reservado."

msgid "You can not change the plan since seat \"%s\" is not present in the new plan and is already used in a voucher."
msgstr "No se puede cambiar el plano, ya que el asiento \"%s\" no está presente en el nuevo plano y ya está usado en un código."

msgid "The download file could no longer be found on the server, please try to start again."
msgstr "El archivo de descarga ya no se encuentra en el servidor, por favor, intenta comenzar de nuevo."

msgid "This file is from a different event."
msgstr "Este archivo es de una agenda diferente."

msgid "The confirm code you entered was incorrect."
msgstr "El código de confirmación introducido era incorrecto."

msgid "Something happened in your event after the export, please try again."
msgstr "Ha sucedido algo en tu agenda después de la exportación, por favor, inténtalo de nuevo."

msgid "Data shredding completed for %(event)s"
msgstr "Destrucción de datos completada para %(event)s"

msgid "Uncategorized"
msgstr "Sin categoría"

msgid "Your VAT ID could not be checked, as the VAT checking service of your country is currently not available. We will therefore need to charge you the same tax rate as if you did not enter a VAT ID."
msgstr "No se ha podido verificar tu NIF/CIF, ya que el servicio de verificación del IVA de tu país no está disponible en este momento. Por lo tanto, tendremos que aplicar la misma tasa de impuestos que si no hubieras introducido un NIF/CIF."

msgid "This VAT ID is not valid. Please re-check your input."
msgstr "Este NIF/CIF no es válido. Por favor, revisa lo introducido."

msgid "Your VAT ID does not match the selected country."
msgstr "Tu NIF/CIF no coincide con el país seleccionado."

msgid "Your VAT ID could not be checked, as the VAT checking service of your country returned an incorrect result. We will therefore need to charge VAT on your invoice. Please contact support to resolve this manually."
msgstr "No se ha podido comprobar tu NIF/CIF, ya que el servicio de comprobación del IVA de tu país ha devuelto un resultado incorrecto. Por lo tanto, tendremos que aplicar IVA en la factura. Ponte en contacto con soporte para resolver esto manualmente."

msgid "Your VAT ID could not be checked, as the VAT checking service of your country is currently not available. We will therefore need to charge VAT on your invoice. You can get the tax amount back via the VAT reimbursement process."
msgstr "No se ha podido comprobar tu NIF/CIF, ya que el servicio de comprobación del IVA de tu país no está disponible actualmente. Por lo tanto, tendremos que aplicar IVA en la factura. Puedes recuperar el importe del impuesto mediante el proceso de reembolso de IVA."

msgid "Sample workshop"
msgstr "Ejemplo de taller"

msgid "pretix update available"
msgstr "actualización de pretix disponible"

msgid "Hi!\n\nAn update is available for pretix or for one of the plugins you installed in your pretix installation. Please click on the following link for more information:\n\n {url} \n\nYou can always find information on the latest updates on the pretix.eu blog:\n\nhttps://pretix.eu/about/en/blog/\n\nBest,\n\nyour pretix developers"
msgstr "Hola!\n\nHay una actualización disponible para pretix o para uno de los plugins instalados en tu instalación de pretix. Por favor, haz clic en el siguiente enlace para más información:\n\n {url} \n\nSiempre puedes encontrar información sobre las últimas actualizaciones en el blog pretix.eu:\n\nhttps://pretix.eu/about/en/blog/\n\nSaludos,\n\ntus desarrolladores de pretix"

msgid "Plugin: %s"
msgstr "Plugin: %s"

msgid "The voucher has been sent to {recipient}."
msgstr "El código se ha enviado a {recipient}."

msgid "Compute taxes for every line individually"
msgstr "Calcular impuestos para cada línea individualmente"

msgid "Compute taxes based on net total"
msgstr "Calcular impuestos basándose en el total neto"

msgid "For business customers, compute taxes based on net total. For individuals, use line-based rounding"
msgstr "Para clientes empresariales, calcular impuestos basándose en el total neto. Para particulares, usar redondeo por línea"

msgid "Compute taxes based on net total with stable gross prices"
msgstr "Calcular impuestos basándose en el total neto con precios brutos estables"

msgid "Allow usage of restricted plugins"
msgstr "Permitir el uso de plugins restringidos"

msgid "Allow customers to create accounts"
msgstr "Permitir a los clientes crear cuentas"

msgid "This will allow customers to sign up for an account on your ticket shop. This is a prerequisite for some advanced features like memberships."
msgstr "Esto permitirá a los clientes registrarse en la página de reservas. Es un requisito previo para algunas funciones avanzadas como las membresías."

msgid "Allow customers to log in with email address and password"
msgstr "Permitir a los clientes iniciar sesión con correo electrónico y contraseña"

msgid "If disabled, you will need to connect one or more single-sign-on providers."
msgstr "Si está desactivado, será necesario conectar uno o más proveedores de inicio de sesión único."

msgid "Require login to access order confirmation pages"
msgstr "Requerir inicio de sesión para acceder a las páginas de confirmación de reserva"

msgid "If enabled, users who were logged in at the time of purchase must also log in to access their order information. If a customer account is created while placing an order, the restriction only becomes active after the customer account is activated."
msgstr "Si está activado, los usuarios que iniciaron sesión en el momento de la reserva también deberán iniciar sesión para acceder a su información. Si se crea una cuenta de cliente al hacer una reserva, la restricción solo se activará después de que se active la cuenta."

msgid "Match orders based on email address"
msgstr "Vincular reservas según la dirección de correo electrónico"

msgid "This will allow registered customers to access orders made with the same email address, even if the customer was not logged in during the purchase."
msgstr "Esto permitirá a los clientes registrados acceder a reservas realizadas con la misma dirección de correo electrónico, aunque no iniciaran sesión durante la reserva."

msgid "Activate reusable media"
msgstr "Activar soportes reutilizables"

msgid "The reusable media feature allows you to connect tickets and gift cards with physical media such as wristbands or chip cards that may be reused for different tickets or gift cards later."
msgstr "La función de soportes reutilizables permite conectar plazas y tarjetas regalo con soportes físicos como pulseras o tarjetas chip que pueden reutilizarse para diferentes plazas o tarjetas regalo más adelante."

msgid "Enforce the usage of issued reusable media for check-in"
msgstr "Exigir el uso de soportes reutilizables emitidos para el registro de llegada"

msgid "If enabled, a ticket barcode will not be accepted anymore, if a reusable medium has been created and linked to a ticket. Keeping this option turned off will treat the reusable medium and ticket as equals."
msgstr "Si está activado, un código de barras de plaza ya no se aceptará si se ha creado un soporte reutilizable y se ha vinculado a una plaza. Mantener esta opción desactivada tratará el soporte reutilizable y la plaza como equivalentes."

msgid "Length of barcodes"
msgstr "Longitud de los códigos de barras"

msgid "Automatically create a new gift card if a previously unknown chip is seen"
msgstr "Crear automáticamente una nueva tarjeta regalo si se detecta un chip previamente desconocido"

msgid "Gift card currency"
msgstr "Moneda de la tarjeta regalo"

msgid "Automatically create a new gift card if a new chip is encoded"
msgstr "Crear automáticamente una nueva tarjeta regalo si se codifica un nuevo chip"

msgid "Use UID protection feature of NFC chip"
msgstr "Usar función de protección UID del chip NFC"

msgid "Maximum number of items per order"
msgstr "Número máximo de servicios por reserva"

msgid "Add-on products will not be counted."
msgstr "Los servicios complementarios no se contarán."

msgid "Show net prices instead of gross prices in the product list"
msgstr "Mostrar precios netos en lugar de precios brutos en la lista de servicios"

msgid "Independent of your choice, the cart will show gross prices as this is the price that needs to be paid."
msgstr "Independientemente de tu elección, tu selección mostrará los precios brutos, ya que este es el precio que debe pagarse."

msgid "Hide prices on attendee ticket page"
msgstr "Ocultar precios en la página de plazas para participantes"

msgid "If a person buys multiple tickets and you send emails to all of the attendees, with this option the ticket price will not be shown on the ticket page of the individual attendees. The ticket buyer will of course see the price."
msgstr "Si una persona reserva varias plazas y envías correos a todos los participantes, con esta opción el precio de la plaza no se mostrará en la página individual de cada participante. El cliente que hizo la reserva verá el precio, por supuesto."

msgid "Ask for attendee names"
msgstr "Pedir los nombres de los participantes"

msgid "Ask for a name for all personalized tickets."
msgstr "Pide un nombre para todas las plazas personalizadas."

msgid "Require attendee names"
msgstr "Requerir nombres de participantes"

msgid "Require customers to fill in the names of all attendees."
msgstr "Requiere que los clientes rellenen los nombres de todos los participantes."

msgid "Ask for email addresses per ticket"
msgstr "Pedir direcciones de correo por plaza"

msgid "Normally, pretix asks for one email address per order and the order confirmation will be sent only to that email address. If you enable this option, the system will additionally ask for individual email addresses for every personalized ticket. This might be useful if you want to obtain individual addresses for every attendee even in case of group orders. However, pretix will send the order confirmation by default only to the one primary email address, not to the per-attendee addresses. You can however enable this in the email settings."
msgstr "Normalmente, pretix solicita una dirección de correo por reserva y la confirmación se enviará solo a esa dirección. Si activas esta opción, el sistema pedirá además direcciones de correo individuales para cada plaza personalizada. Puede ser útil si quieres obtener direcciones individuales de cada participante incluso en reservas de grupo. Sin embargo, pretix enviará la confirmación por defecto solo a la dirección de correo principal, no a las direcciones por participante. Puedes activar esto en la configuración de correo."

msgid "Require email addresses per ticket"
msgstr "Requerir direcciones de correo por plaza"

msgid "Require customers to fill in individual email addresses for all personalized tickets. See the above option for more details. One email address for the order confirmation will always be required regardless of this setting."
msgstr "Requiere que los clientes rellenen direcciones de correo individuales para todas las plazas personalizadas. Consulta la opción anterior para más detalles. Siempre se requerirá una dirección de correo para la confirmación de la reserva independientemente de esta configuración."

msgid "Ask for company per ticket"
msgstr "Pedir empresa por plaza"

msgid "Require company per ticket"
msgstr "Requerir empresa por plaza"

msgid "Ask for postal addresses per ticket"
msgstr "Pedir direcciones postales por plaza"

msgid "Require postal addresses per ticket"
msgstr "Requerir direcciones postales por plaza"

msgid "Ask for the order email address twice"
msgstr "Pedir la dirección de correo de la reserva dos veces"

msgid "Require customers to fill in the primary email address twice to avoid errors."
msgstr "Requiere que los clientes rellenen la dirección de correo principal dos veces para evitar errores."

msgid "Ask for a phone number per order"
msgstr "Pedir un número de teléfono por reserva"

msgid "Require a phone number per order"
msgstr "Requerir un número de teléfono por reserva"

msgid "Rounding of taxes"
msgstr "Redondeo de impuestos"

msgid "Note that if you transfer your sales data from pretix to an external system for tax reporting, you need to make sure to account for possible rounding differences if your external system rounds differently than pretix."
msgstr "Ten en cuenta que si transfieres tus datos de reservas desde pretix a un sistema externo para la declaración de impuestos, debes asegurarte de tener en cuenta las posibles diferencias de redondeo si tu sistema externo redondea de forma diferente a pretix."

msgid "Ask for invoice address"
msgstr "Pedir dirección de facturación"

msgid "Do not ask for invoice address if an order is free"
msgstr "No pedir dirección de facturación si una reserva es gratuita"

msgid "Require customer name"
msgstr "Requerir nombre del cliente"

msgid "Show attendee names on invoices"
msgstr "Mostrar nombres de participantes en las facturas"

msgid "Show event location on invoices"
msgstr "Mostrar ubicación del evento en las facturas"

msgid "The event location will be shown below the list of products if it is the same for all lines. It will be shown on every line if there are different locations."
msgstr "La ubicación del evento se mostrará debajo de la lista de servicios si es la misma para todas las líneas. Se mostrará en cada línea si hay ubicaciones diferentes."

msgid "Show exchange rates"
msgstr "Mostrar tipos de cambio"

msgid "Never"
msgstr "Nunca"

msgid "Based on European Central Bank daily rates, whenever the invoice recipient is in an EU country that uses a different currency."
msgstr "Basado en los tipos diarios del Banco Central Europeo, cuando el destinatario de la factura esté en un país de la UE que use una moneda diferente."

msgid "Based on Czech National Bank daily rates, whenever the invoice amount is not in CZK."
msgstr "Basado en los tipos diarios del Banco Nacional Checo, cuando el importe de la factura no esté en CZK."

msgid "Based on National Bank of Poland daily rates, whenever the invoice amount is not in PLN."
msgstr "Basado en los tipos diarios del Banco Nacional de Polonia, cuando el importe de la factura no esté en PLN."

msgid "Require invoice address"
msgstr "Requerir dirección de facturación"

msgid "Require a business address"
msgstr "Requerir dirección profesional"

msgid "This will require users to enter a company name."
msgstr "Esto requerirá que los usuarios introduzcan un nombre de empresa."

msgid "Ask for beneficiary"
msgstr "Pedir beneficiario"

msgid "Custom recipient field label"
msgstr "Etiqueta personalizada del campo de destinatario"

msgid "If you want to add a custom text field, e.g. for a country-specific registration number, to your invoice address form, please fill in the label here. This label will both be used for asking the user to input their details as well as for displaying the value on the invoice. It will be shown on the invoice below the headline. The field will not be required."
msgstr "Si quieres añadir un campo de texto personalizado, por ejemplo para un número de registro específico de un país, en tu formulario de dirección de facturación, rellena aquí la etiqueta. Esta etiqueta se utilizará tanto para pedir al usuario que introduzca sus datos como para mostrar el valor en la factura. Se mostrará en la factura debajo del titular. El campo no será obligatorio."

msgid "Custom recipient field help text"
msgstr "Texto de ayuda del campo de destinatario personalizado"

msgid "If you use the custom recipient field, you can specify a help text which will be displayed underneath the field. It will not be displayed on the invoice."
msgstr "Si usas el campo de destinatario personalizado, puedes especificar un texto de ayuda que se mostrará debajo del campo. No se mostrará en la factura."

msgid "Ask for VAT ID"
msgstr "Pedir NIF/CIF"

msgid "Only works if an invoice address is asked for. VAT ID is only requested from business customers in the following countries: {countries}."
msgstr "Solo funciona si se solicita una dirección de facturación. El NIF/CIF solo se solicita a clientes empresariales de los siguientes países: {countries}."

msgid "Require VAT ID in"
msgstr "Requerir NIF/CIF en"

msgid "VAT ID is optional by default, because not all businesses are assigned a VAT ID in all countries. VAT ID will be required for all business addresses in the selected countries."
msgstr "El NIF/CIF es opcional por defecto, ya que no todas las empresas tienen asignado un NIF/CIF en todos los países. El NIF/CIF será obligatorio para todas las direcciones empresariales en los países seleccionados."

msgid "Invoice address explanation"
msgstr "Explicación de la dirección de facturación"

msgid "This text will be shown above the invoice address form during checkout."
msgstr "Este texto se mostrará encima del formulario de dirección de facturación durante el proceso de reserva."

msgid "Show paid amount on partially paid invoices"
msgstr "Mostrar importe pagado en facturas parcialmente pagadas"

msgid "If an invoice has already been paid partially, this option will add the paid and pending amount to the invoice."
msgstr "Si una factura ya ha sido pagada parcialmente, esta opción añadirá el importe pagado y pendiente a la factura."

msgid "Show free products on invoices"
msgstr "Mostrar servicios gratuitos en las facturas"

msgid "Note that invoices will never be generated for orders that contain only free products."
msgstr "Ten en cuenta que nunca se generarán facturas para reservas que contengan solo servicios gratuitos."

msgid "Show expiration date of order"
msgstr "Mostrar fecha de expiración de la reserva"

msgid "The expiration date will not be shown if the invoice is generated after the order is paid."
msgstr "La fecha de expiración no se mostrará si la factura se genera después de pagar la reserva."

msgid "Minimum length of invoice number after prefix"
msgstr "Longitud mínima del número de factura después del prefijo"

msgid "The part of your invoice number after your prefix will be filled up with leading zeros up to this length, e.g. INV-001 or INV-00001."
msgstr "La parte de tu número de factura después del prefijo se completará con ceros a la izquierda hasta esta longitud, por ejemplo INV-001 o INV-00001."

msgid "Generate invoices with consecutive numbers"
msgstr "Generar facturas con números consecutivos"

msgid "If deactivated, the order code will be used in the invoice number."
msgstr "Si está desactivado, el código de reserva se utilizará en el número de factura."

msgid "Invoice number prefix"
msgstr "Prefijo del número de factura"

msgid "This will be prepended to invoice numbers. If you leave this field empty, your event slug will be used followed by a dash. Attention: If multiple events within the same organization use the same value in this field, they will share their number range, i.e. every full number will be used at most once over all of your events. This setting only affects future invoices. You can use %Y (with century) %y (without century) to insert the year of the invoice, or %m and %d for the day of month."
msgstr "Esto se antepondrá a los números de factura. Si dejas este campo vacío, se utilizará la URL semántica de tu evento seguida de un guión. Atención: si varios eventos dentro del mismo negocio usan el mismo valor en este campo, compartirán su rango de números, es decir, cada número completo se usará como máximo una vez en todos tus eventos. Esta configuración solo afecta a facturas futuras. Puedes usar %Y (con siglo) %y (sin siglo) para insertar el año de la factura, o %m y %d para el día del mes."

msgid "Please only use the characters {allowed} in this field."
msgstr "Utiliza únicamente los caracteres {allowed} en este campo."

msgid "Invoice number prefix for cancellations"
msgstr "Prefijo del número de factura para cancelaciones"

msgid "This will be prepended to invoice numbers of cancellations. If you leave this field empty, the same numbering scheme will be used that you configured for regular invoices."
msgstr "Esto se antepondrá a los números de factura de las cancelaciones. Si dejas este campo vacío, se utilizará el mismo esquema de numeración que configuraste para las facturas normales."

msgid "Highlight order code to make it stand out visibly"
msgstr "Resalta el código de reserva para que destaque visualmente"

msgid "Only respected by some invoice renderers."
msgstr "Solo respetado por algunos generadores de facturas."

msgid "Font"
msgstr "Fuente"

msgid "Length of ticket codes"
msgstr "Longitud de los códigos de plaza"

msgid "Reservation period"
msgstr "Período de reserva"

msgid "The number of minutes the items in a user's cart are reserved for this user."
msgstr "El número de minutos que los servicios en tu selección están reservados."

msgid "Directly redirect to check-out after a product has been added to the cart."
msgstr "Redirigir directamente a continuar con la reserva después de que un servicio se haya añadido a tu selección."

msgid "End of presale text"
msgstr "Texto de fin de período de reservas"

msgid "This text will be shown above the ticket shop once the designated sales timeframe for this event is over. You can use it to describe other options to get a ticket, such as a box office."
msgstr "Este texto se mostrará en la página de reservas una vez que finalice el período de reservas designado para esta agenda. Puedes usarlo para describir otras opciones para reservar, por ejemplo en una taquilla física."

msgid "No dates match your criteria."
msgstr "No hay sesiones que se ajusten a tus criterios."

msgctxt "subevents"
msgid "Text for empty date results"
msgstr "Texto para los resultados con sesiones vacías"

msgctxt "subevents"
msgid "This text will be shown if the calendar or list of dates is empty, e.g. because a month does not contain any dates or a filter chosen by the user does not find any results. You can use this to advertise ways to get in touch with you to arrange further dates. We do not recommend more than one or two sentences."
msgstr "Este texto aparecerá si el calendario o la lista de sesiones están vacíos, por ejemplo, porque un mes no contiene ninguna sesión o porque el filtro seleccionado no arroja ningún resultado. Puedes aprovecharlo para indicar cómo ponerse en contacto para concertar otras citas. No recomendamos más de una o dos frases."

msgid "Guidance text"
msgstr "Texto guía"

msgid "This text will be shown above the payment options. You can explain the choices to the user here, if you want."
msgstr "Este texto se mostrará arriba de las opciones de pago. Puedes explicarle las opciones aquí, si quieres."

msgid "in days"
msgstr "en días"

msgid "in minutes"
msgstr "en minutos"

msgid "Set payment term"
msgstr "Establecer plazo de pago"

msgid "If using days, the order will expire at the end of the last day. Using minutes is more exact, but should only be used for real-time payment methods."
msgstr "Si usas días, la reserva caducará al final del último día. Usar minutos es más exacto, pero solo debe usarse para métodos de pago en tiempo real."

msgid "Payment term in days"
msgstr "Plazo de pago en días"

msgid "The number of days after placing an order the user has to pay to preserve their reservation. If you use slow payment methods like bank transfer, we recommend 14 days. If you only use real-time payment methods, we recommend still setting two or three days to allow people to retry failed payments."
msgstr "El número de días después de hacer una reserva que el cliente tiene para pagar y conservarla. Si usas métodos de pago lentos como transferencia bancaria, recomendamos 14 días. Si solo usas métodos de pago en tiempo real, recomendamos igualmente establecer dos o tres días para permitir reintentar pagos fallidos."

msgid "Only end payment terms on weekdays"
msgstr "Finalizar plazos de pago solo en días laborables"

msgid "If this is activated and the payment term of any order ends on a Saturday or Sunday, it will be moved to the next Monday instead. This is required in some countries by civil law. This will not effect the last date of payments configured below."
msgstr "Si se activa y el plazo de pago de cualquier reserva finaliza en sábado o domingo, se trasladará al lunes siguiente. Esto es requerido en algunos países por ley civil. Esto no afectará la última fecha de pagos configurada a continuación."

msgid "Payment term in minutes"
msgstr "Plazo de pago en minutos"

msgid "The number of minutes after placing an order the user has to pay to preserve their reservation. Only use this if you exclusively offer real-time payment methods. Please note that for technical reasons, the actual time frame might be a few minutes longer before the order is marked as expired."
msgstr "El número de minutos después de hacer una reserva que el cliente tiene para pagar y conservarla. Usa esto únicamente si ofreces exclusivamente métodos de pago en tiempo real. Ten en cuenta que, por motivos técnicos, el plazo real puede ser unos minutos más largo antes de que la reserva se marque como caducada."

msgid "Last date of payments"
msgstr "Última fecha de pagos"

msgid "The last date any payments are accepted. This has precedence over the terms configured above. If you use the event series feature and an order contains tickets for multiple dates, the earliest date will be used."
msgstr "La última fecha en que se aceptan pagos. Esto tiene prioridad sobre los plazos configurados anteriormente. Si usas la función de serie de sesiones y una reserva contiene plazas para varias sesiones, se utilizará la fecha más temprana."

msgid "Automatically expire unpaid orders"
msgstr "Caducar automáticamente las reservas pendientes de pago"

msgid "If checked, all unpaid orders will automatically go from 'pending' to 'expired' after the end of their payment deadline. This means that those tickets go back to the pool and can be ordered by other people."
msgstr "Si se marca, todas las reservas pendientes de pago pasarán automáticamente de 'pendiente' a 'caducada' una vez finalizado el plazo de pago. Esto significa que esas plazas vuelven al cupo disponible y pueden ser reservadas por otras personas."

msgid "Expiration delay"
msgstr "Retraso de caducidad"

msgid "The order will only actually expire this many days after the expiration date communicated to the customer. If you select \"Only end payment terms on weekdays\" above, this will also be respected. However, this will not delay beyond the \"last date of payments\" configured above, which is always enforced."
msgstr "La reserva solo caducará realmente estos días después de la fecha de caducidad comunicada al cliente. Si seleccionas \"Finalizar plazos de pago solo en días laborables\" arriba, esto también se respetará. Sin embargo, esto no retrasará más allá de la \"última fecha de pagos\" configurada anteriormente, que siempre se aplica."

msgid "Hide \"payment pending\" state on customer-facing pages"
msgstr "Ocultar el estado \"pago pendiente\" en las páginas del cliente"

msgid "The payment instructions panel will still be shown to the primary customer, but no indication of missing payment will be visible on the ticket pages of attendees who did not buy the ticket themselves."
msgstr "El panel de instrucciones de pago seguirá mostrándose al cliente principal, pero no se verá ninguna indicación de pago pendiente en las páginas de plazas de participantes que no hicieron la reserva ellos mismos."

msgid "If you have a gift card, please enter the gift card code here. If the gift card does not have enough credit to pay for the full order, you will be shown this page again and you can either redeem another gift card or select a different payment method for the difference."
msgstr "Si tienes una tarjeta regalo, introduce aquí el código de la tarjeta regalo. Si la tarjeta regalo no tiene crédito suficiente para pagar la reserva completa, se te volverá a mostrar esta página y podrás canjear otra tarjeta regalo o seleccionar un método de pago diferente para la diferencia."

msgid "Accept late payments"
msgstr "Aceptar pagos atrasados"

msgid "Accept payments for orders even when they are in 'expired' state as long as enough capacity is available. No payments will ever be accepted after the 'Last date of payments' configured above."
msgstr "Aceptar pagos para reservas incluso cuando estén en estado 'caducada' siempre que haya suficiente cupo disponible. No se aceptará ningún pago después de la 'última fecha de pagos' configurada anteriormente."

msgid "Allow postponed payment choice for sales channels"
msgstr "Permitir elección de pago aplazado para canales de venta"

msgid "If postponed payment is allowed on a sales channel, customers can complete their order without selecting a payment method. This is useful whenever orders are not created by the same person who is making the payment."
msgstr "Si se permite el pago aplazado en un canal de venta, los clientes pueden completar su reserva sin seleccionar un método de pago. Esto es útil cuando las reservas no las crea la misma persona que realizará el pago."

msgid "Show start date"
msgstr "Mostrar fecha de inicio"

msgid "Show the presale start date before presale has started."
msgstr "Mostrar la fecha de apertura a reservas antes de que se abra."

msgid "Use default tax rate"
msgstr "Usar tipo impositivo por defecto"

msgid "Charge no taxes"
msgstr "No cobrar impuestos"

msgid "Tax handling on payment fees"
msgstr "Tratamiento fiscal de las comisiones de pago"

msgid "Use same taxes as order positions (split according to net prices)"
msgstr "Usar los mismos impuestos que las plazas de la reserva (repartidos según los precios netos)"

msgid "Tax handling on cancellation fees"
msgstr "Tratamiento fiscal de las comisiones de cancelación"

msgid "Do not generate invoices"
msgstr "No generar facturas"

msgid "Only manually in admin panel"
msgstr "Solo manualmente en el panel de administración"

msgid "Automatically on user request"
msgstr "Automáticamente a petición del cliente"

msgid "Automatically on user request for paid orders"
msgstr "Automáticamente a petición del cliente para reservas pagadas"

msgid "Automatically for all created orders"
msgstr "Automáticamente para todas las reservas creadas"

msgid "Automatically on payment or when required by payment method"
msgstr "Automáticamente al pagar o cuando lo requiera el método de pago"

msgid "Generate invoices"
msgstr "Generar facturas"

msgid "Automatically after payment or when required by payment method"
msgstr "Automáticamente después del pago o cuando lo requiera el método de pago"

msgid "Automatically before payment for all created orders"
msgstr "Automáticamente antes del pago para todas las reservas creadas"

msgid "Invoices will never be automatically generated for free orders."
msgstr "Las facturas nunca se generarán automáticamente para reservas gratuitas."

msgid "Automatic based on ticket-specific validity, membership validity, event series date, or event date"
msgstr "Automático, según la validez específica de la plaza, la validez de la membresía, la fecha de la serie de sesiones o la fecha de la sesión"

msgid "Automatic, but prefer invoice date over event date"
msgstr "Automático, pero se prefiere la fecha de la factura sobre la fecha de la sesión"

msgid "Invoice date"
msgstr "Fecha de la factura"

msgid "Date of service"
msgstr "Fecha de servicio"

msgid "This controls what dates are shown on the invoice, but is especially important for electronic invoicing."
msgstr "Esto controla qué fechas se muestran en la factura, pero es especialmente importante para la facturación electrónica."

msgid "Automatically cancel and reissue invoice on address changes"
msgstr "Cancelar y reemitir automáticamente la factura en caso de cambios de dirección"

msgid "If customers change their invoice address on an existing order, the invoice will automatically be canceled and a new invoice will be issued. This setting does not affect changes made through the backend."
msgstr "Si los clientes cambian su dirección de facturación en una reserva existente, la factura se cancelará automáticamente y se emitirá una nueva factura. Este ajuste no afecta los cambios realizados a través del panel de administración."

msgid "Allow updating existing invoices"
msgstr "Permitir actualizar facturas existentes"

msgid "By default, invoices can never again be changed once they are issued. In most countries, we recommend to leave this option turned off and always issue a new invoice if a change needs to be made."
msgstr "Por defecto, las facturas no pueden modificarse una vez emitidas. En la mayoría de países, recomendamos dejar esta opción desactivada y emitir siempre una nueva factura si es necesario realizar algún cambio."

msgid "Only issue invoices to business customers"
msgstr "Emitir facturas únicamente a clientes empresariales"

msgid "Address line"
msgstr "Línea de dirección"

msgid "Albert Einstein Road 52"
msgstr "Calle Albert Einstein 52"

msgid "Domestic tax ID"
msgstr "Número de identificación fiscal"

msgid "e.g. tax number in Germany, ABN in Australia, …"
msgstr "p. ej. NIF en España, número fiscal en Alemania, ABN en Australia…"

msgid "EU VAT ID"
msgstr "NIF IVA (UE)"

msgid "e.g. With this document, we sent you the invoice for your ticket order."
msgstr "Por ejemplo: Junto a este documento te enviamos la factura de tu reserva."

msgid "Introductory text"
msgstr "Texto de introducción"

msgid "Will be printed on every invoice above the invoice rows."
msgstr "Se imprimirá en cada factura por encima de las líneas de factura."

msgid "e.g. Thank you for your purchase! You can find more information on the event at ..."
msgstr "Por ejemplo: ¡Gracias por tu reserva! Puedes encontrar más información sobre la sesión en..."

msgid "Additional text"
msgstr "Texto adicional"

msgid "Will be printed on every invoice below the invoice total."
msgstr "Se imprimirá en cada factura por debajo del total de la factura."

msgid "e.g. your bank details, legal details like your VAT ID, registration numbers, etc."
msgstr "p. ej. tus datos bancarios, datos legales como tu NIF IVA, números de registro, etc."

msgid "Footer"
msgstr "Pie de página"

msgid "Will be printed centered and in a smaller font at the end of every invoice page."
msgstr "Se imprimirá centrado y en una fuente más pequeña al final de cada página de la factura."

msgid "Attach invoices to emails"
msgstr "Adjuntar facturas a correos electrónicos"

msgid "If invoices are automatically generated for all orders, they will be attached to the order confirmation mail. If they are automatically generated on payment, they will be attached to the payment confirmation mail. If they are not automatically generated, they will not be attached to emails."
msgstr "Si las facturas se generan automáticamente para todas las reservas, se adjuntarán al correo de confirmación de reserva. Si se generan automáticamente en el momento del pago, se adjuntarán al correo de confirmación de pago. Si no se generan automáticamente, no se adjuntarán a los correos electrónicos."

msgid "Email address to receive a copy of each invoice"
msgstr "Dirección de correo electrónico para recibir una copia de cada factura"

msgid "Each newly created invoice will be sent to this email address shortly after creation. You can use this for an automated import of invoices to your accounting system. The invoice will be the only attachment of the email."
msgstr "Cada factura recién creada se enviará a esta dirección de correo electrónico poco después de su creación. Puedes usar esto para una importación automatizada de facturas a tu sistema de contabilidad. La factura será el único archivo adjunto del correo electrónico."

msgid "Show items outside presale period"
msgstr "Mostrar servicios fuera del periodo de reservas"

msgid "Show item details before presale has started and after presale has ended"
msgstr "Mostrar los detalles del servicio antes de que comience y después de que finalice el periodo de reservas"

msgid "Available languages"
msgstr "Idiomas disponibles"

msgid "Default language"
msgstr "Idioma por defecto"

msgid "Region"
msgstr "Región"

msgid "Will be used to determine date and time formatting as well as default country for customer addresses and phone numbers. For formatting, this takes less priority than the language and is therefore mostly relevant for languages used in different regions globally (like English)."
msgstr "Se utilizará para determinar el formato de fecha y hora, así como el país predeterminado para las direcciones y números de teléfono de los clientes. Para el formato, esto tiene menos prioridad que el idioma y, por lo tanto, es más relevante para idiomas utilizados en diferentes regiones del mundo (como el inglés)."

msgid "This shop represents an event"
msgstr "Esta página de reservas representa un evento"

msgid "Uncheck this box if you are only selling something that has no specific date, such as gift cards or a ticket that can be used any time. The system will then stop showing the event date in some places like the event start page. Note that pretix still is a system built around events and the date may still show up in other places."
msgstr "Desmarca esta casilla si solo vendes algo que no tiene una fecha específica, como tarjetas regalo o una plaza que se puede utilizar en cualquier momento. El sistema dejará de mostrar la fecha del evento en algunos lugares como la página de inicio. Ten en cuenta que pretix sigue siendo un sistema construido en torno a eventos y la fecha todavía puede aparecer en otros lugares."

msgid "Show event end date"
msgstr "Mostrar fecha de finalización del evento"

msgid "If disabled, only event's start date will be displayed to the public."
msgstr "Si está desactivado, solo se mostrará al público la fecha de inicio del evento."

msgid "Show dates with time"
msgstr "Mostrar fechas con hora"

msgid "If disabled, the event's start and end date will be displayed without the time of day."
msgstr "Si está desactivado, las fechas de inicio y fin del evento se mostrarán sin la hora del día."

msgid "Hide all products that are sold out"
msgstr "Ocultar todos los servicios que estén completos"

msgid "Publicly show how many tickets of a certain type are still available."
msgstr "Mostrar públicamente cuántas plazas de un determinado tipo todavía están disponibles."

msgid "Ask search engines not to index the ticket shop"
msgstr "Solicitar a los motores de búsqueda que no indexen la página de reservas"

msgid "Show variations of a product expanded by default"
msgstr "Mostrar variaciones de un servicio expandido por defecto"

msgid "Enable waiting list"
msgstr "Activar lista de espera"

msgid "Once a ticket is sold out, people can add themselves to a waiting list. As soon as a ticket becomes available again, it will be reserved for the first person on the waiting list and this person will receive an email notification with a voucher that can be used to buy a ticket."
msgstr "Una vez que un servicio esté completo, las personas pueden añadirse a una lista de espera. Tan pronto como una plaza vuelva a estar disponible, se reservará para la primera persona en la lista de espera y esta persona recibirá una notificación por correo electrónico con un código que se puede utilizar para reservar una plaza."

msgid "Automatic waiting list assignments"
msgstr "Asignaciones automáticas de lista de espera"

msgid "If ticket capacity becomes free, automatically create a voucher and send it to the first person on the waiting list for that product. If this is not active, mails will not be send automatically but you can send them manually via the control panel. If you disable the waiting list but keep this option enabled, tickets will still be sent out."
msgstr "Si se libera capacidad, automáticamente se crea un código y se envía a la primera persona en la lista de espera para ese servicio. Si esto no está activo, los correos no se enviarán automáticamente, pero puedes enviarlos manualmente a través del panel de control. Si desactivas la lista de espera pero mantienes esta opción activa, las plazas seguirán enviándose."

msgid "Waiting list response time"
msgstr "Tiempo de respuesta de la lista de espera"

msgid "If a ticket voucher is sent to a person on the waiting list, it has to be redeemed within this number of hours until it expires and can be re-assigned to the next person on the list."
msgstr "Si se envía un código de plaza a una persona en la lista de espera, debe canjearse dentro de este número de horas hasta que expire y pueda reasignarse a la siguiente persona en la lista."

msgid "Disable waiting list"
msgstr "Desactivar lista de espera"

msgid "The waiting list will be fully disabled after this date. This means that nobody can add themselves to the waiting list any more, but also that tickets will be available for sale again if quota permits, even if there are still people on the waiting list. Vouchers that have already been sent remain active."
msgstr "La lista de espera se desactivará completamente después de esta fecha. Esto significa que nadie podrá añadirse a la lista de espera, pero también que las plazas estarán disponibles de nuevo si el cupo lo permite, aunque todavía haya personas en la lista de espera. Los códigos que ya se han enviado permanecen activos."

msgid "Ask for a name"
msgstr "Solicitar un nombre"

msgid "Ask for a name when signing up to the waiting list."
msgstr "Solicitar un nombre al apuntarse a la lista de espera."

msgid "Require name"
msgstr "Requerir nombre"

msgid "Require a name when signing up to the waiting list.."
msgstr "Requerir un nombre al apuntarse a la lista de espera."

msgid "Ask for a phone number"
msgstr "Solicitar un número de teléfono"

msgid "Ask for a phone number when signing up to the waiting list."
msgstr "Solicitar un número de teléfono al apuntarse a la lista de espera."

msgid "Require phone number"
msgstr "Requerir número de teléfono"

msgid "Require a phone number when signing up to the waiting list.."
msgstr "Requerir un número de teléfono al apuntarse a la lista de espera."

msgid "Phone number explanation"
msgstr "Explicación del número de teléfono"

msgid "If you ask for a phone number, explain why you do so and what you will use the phone number for."
msgstr "Si solicitas un número de teléfono, explica por qué lo haces y para qué lo utilizarás."

msgid "Maximum number of entries per email address for the same product"
msgstr "Número máximo de entradas por dirección de correo electrónico para el mismo servicio"

msgid "With an increased limit, a customer may request more than one ticket for a specific product using the same, unique email address. However, regardless of this setting, they will need to fill the waiting list form multiple times if they want more than one ticket, as every entry only grants one single ticket at a time."
msgstr "Con un límite aumentado, un cliente puede solicitar más de una plaza para un servicio específico utilizando la misma dirección de correo electrónico. Sin embargo, independientemente de esta configuración, tendrá que rellenar el formulario de la lista de espera varias veces si desea más de una plaza, ya que cada entrada solo concede una plaza a la vez."

msgid "Show number of check-ins to customer"
msgstr "Mostrar número de registros de llegada al cliente"

msgid "With this option enabled, your customers will be able to see how many times they entered the event. This is usually not necessary, but might be useful in combination with tickets that are usable a specific number of times, so customers can see how many times they have already been used. Exits or failed scans will not be counted, and the user will not see the different check-in lists."
msgstr "Con esta opción activada, tus clientes podrán ver cuántas veces accedieron a la sesión. Normalmente no es necesario, pero puede ser útil junto con plazas que se pueden usar un número específico de veces, para que los clientes vean cuántas veces ya se han usado. Las salidas o escaneos fallidos no se contabilizarán y el cliente no verá las diferentes listas de registro de llegada."

msgid "Allow users to download tickets"
msgstr "Permitir a los clientes descargar plazas"

msgid "If this is off, nobody can download a ticket."
msgstr "Si esto está desactivado, nadie podrá descargar una plaza."

msgid "Download date"
msgstr "Fecha de descarga"

msgid "Ticket download will be offered after this date. If you use the event series feature and an order contains tickets for multiple event dates, download of all tickets will be available if at least one of the event dates allows it."
msgstr "La descarga de plazas se ofrecerá después de esta fecha. Si utilizas la función de series de sesiones y una reserva contiene plazas para varias sesiones, la descarga de todas las plazas estará disponible si al menos una de las sesiones lo permite."

msgid "Generate tickets for add-on products and bundled products"
msgstr "Generar plazas para servicios complementarios y servicios en pack"

msgid "By default, tickets are only issued for products selected individually, not for add-on products or bundled products. With this option, a separate ticket is issued for every add-on product or bundled product as well."
msgstr "Por defecto, las plazas solo se emiten para servicios seleccionados individualmente, no para servicios complementarios o servicios en pack. Con esta opción, también se emite una plaza separada para cada servicio complementario o servicio incluido."

msgid "Generate tickets for all products"
msgstr "Generar plazas para todos los servicios"

msgid "If turned off, tickets are only issued for products that are marked as an \"admission ticket\"in the product settings. You can also turn off ticket issuing in every product separately."
msgstr "Si está desactivado, las plazas solo se emiten para servicios marcados como «plaza de acceso» en la configuración del servicio. También puedes desactivar la emisión de plazas en cada servicio por separado."

msgid "Generate tickets for pending orders"
msgstr "Generar plazas para reservas pendientes"

msgid "If turned off, ticket downloads are only possible after an order has been marked as paid."
msgstr "Si está desactivado, la descarga de plazas solo será posible después de que una reserva se haya marcado como pagada."

msgid "Do not issue ticket before email address is validated"
msgstr "No emitir plaza antes de validar la dirección de correo electrónico"

msgid "If turned on, tickets will not be offered for download directly after purchase. They will be attached to the payment confirmation email (if the file size is not too large), and the customer will be able to download them from the page as soon as they clicked a link in the email. Does not affect orders performed through other sales channels."
msgstr "Si está activado, las plazas no se ofrecerán para descargar directamente después de reservar. Se adjuntarán al correo electrónico de confirmación de pago (si el tamaño del archivo no es demasiado grande) y el cliente podrá descargarlas desde la página en cuanto haga clic en un enlace del correo electrónico. No afecta a las reservas realizadas a través de otros canales de venta."

msgid "Low availability threshold"
msgstr "Umbral de disponibilidad baja"

msgid "If the availability of tickets falls below this percentage, the event (or a date, if it is an event series) will be highlighted to have low availability in the event list or calendar. If you keep this option empty, low availability will not be shown publicly."
msgstr "Si la disponibilidad de plazas cae por debajo de este porcentaje, la agenda (o una sesión, si es una serie de sesiones) se resaltará como de baja disponibilidad en la lista de agendas o calendario. Si dejas esta opción vacía, la baja disponibilidad no se mostrará públicamente."

msgid "Show availability in event overviews"
msgstr "Mostrar disponibilidad en las vistas generales de la agenda"

msgid "If checked, the list of events will show if events are sold out. This might make for longer page loading times if you have lots of events and the shown status might be out of date for up to two minutes."
msgstr "Si está marcado, la lista de agendas mostrará si las sesiones están completas. Esto puede alargar los tiempos de carga de la página si tienes muchas agendas y el estado mostrado puede estar desactualizado hasta dos minutos."

msgid "List"
msgstr "Lista"

msgid "Week calendar"
msgstr "Calendario semanal"

msgid "Month calendar"
msgstr "Calendario mensual"

msgid "Default overview style"
msgstr "Estilo de vista general por defecto"

msgid "If your event series has more than 50 dates in the future, only the month or week calendar can be used."
msgstr "Si tu serie de sesiones tiene más de 50 fechas futuras, solo se puede utilizar el calendario mensual o semanal."

msgid "Show filter options for calendar or list view"
msgstr "Mostrar opciones de filtro para calendario o vista de lista"

msgid "You can set up possible filters as meta properties in your organizer settings."
msgstr "Puedes configurar posibles filtros como metapropiedades en la configuración del negocio."

msgid "Hide all unavailable dates from calendar or list views"
msgstr "Ocultar todas las sesiones no disponibles del calendario o de las vistas de lista"

msgid "Hide all past dates from calendar"
msgstr "Ocultar todas las sesiones pasadas del calendario"

msgid "No modifications after order was submitted"
msgstr "Ninguna modificación después de confirmar la reserva"

msgid "Only the person who ordered can make changes"
msgstr "Solo quien reservó puede hacer cambios"

msgid "Both the attendee and the person who ordered can make changes"
msgstr "Tanto el participante como quien reservó pueden hacer cambios"

msgid "Allow customers to modify their information"
msgstr "Permitir que los clientes modifiquen su información"

msgid "Allow customers to modify their information after they checked in."
msgstr "Permitir que los clientes modifiquen su información después del registro de llegada."

msgid "By default, no more modifications are possible for an order as soon as one of the tickets in the order has been checked in."
msgstr "Por defecto, no se permiten más modificaciones en una reserva en cuanto se haya registrado la llegada de una de las plazas de la reserva."

msgid "Last date of modifications"
msgstr "Última fecha de modificaciones"

msgid "The last date users can modify details of their orders, such as attendee names or answers to questions. If you use the event series feature and an order contains tickets for multiple event dates, the earliest date will be used."
msgstr "La última fecha en la que los clientes pueden modificar los detalles de sus reservas, como los nombres de los participantes o las respuestas a las preguntas. Si utilizas la función de series de sesiones y una reserva contiene plazas para varias sesiones, se utilizará la fecha más temprana."

msgid "Customers can change the variation of the products they purchased"
msgstr "Los clientes pueden cambiar la variante de los servicios que reservaron"

msgid "Customers can change their selected add-on products"
msgstr "Los clientes pueden cambiar los servicios complementarios seleccionados"

msgid "Only allow changes if the resulting price is higher or equal than the previous price."
msgstr "Solo permitir cambios si el precio resultante es mayor o igual que el precio anterior."

msgid "Only allow changes if the resulting price is higher than the previous price."
msgstr "Solo permitir cambios si el precio resultante es superior al precio anterior."

msgid "Only allow changes if the resulting price is equal to the previous price."
msgstr "Solo permitir cambios si el precio resultante es igual al precio anterior."

msgid "Allow changes regardless of price, as long as no refund is required (i.e. the resulting price is not lower than what has already been paid)."
msgstr "Permitir cambios independientemente del precio, siempre que no se requiera un reembolso (es decir, que el precio resultante no sea inferior a lo ya pagado)."

msgid "Allow changes regardless of price, even if this results in a refund."
msgstr "Permitir cambios independientemente del precio, incluso si resultan en un reembolso."

msgid "Requirement for changed prices"
msgstr "Requisito para precios modificados"

msgid "Do not allow changes after"
msgstr "No permitir cambios después de"

msgid "Allow change even though the ticket has already been checked in"
msgstr "Permitir cambio aunque ya se haya registrado la llegada de la plaza"

msgid "By default, order changes are disabled after any ticket in the order has been checked in. If you check this box, this requirement is lifted. It is still not possible to remove an add-on product that has already been checked in individually. Use with care, and preferably only in combination with a limitation on price changes above."
msgstr "Por defecto, los cambios de reserva están desactivados después de que se haya registrado la llegada de cualquier plaza de la reserva. Si marcas esta casilla, se elimina este requisito. Aun así, no es posible eliminar un servicio complementario que ya se haya registrado individualmente. Úsalo con cuidado y preferiblemente solo junto con una limitación de cambios de precio mencionada arriba."

msgid "Allow individual attendees to change their ticket"
msgstr "Permitir que los participantes individuales cambien su plaza"

msgid "By default, only the person who ordered the tickets can make any changes. If you check this box, individual attendees can also make changes. However, individual attendees can always only make changes that do not change the total price of the order. Such changes can always only be made by the main customer."
msgstr "Por defecto, solo quien reservó las plazas puede hacer cambios. Si marcas esta casilla, los participantes individuales también pueden hacer cambios. Sin embargo, los participantes individuales siempre solo podrán hacer cambios que no modifiquen el precio total de la reserva. Estos cambios solo puede hacerlos siempre el cliente principal."

msgid "Customers can cancel their unpaid orders"
msgstr "Los clientes pueden cancelar sus reservas no pagadas"

msgid "Charge a fixed cancellation fee"
msgstr "Cobrar una tarifa de cancelación fija"

msgid "Only affects orders pending payments, a cancellation fee for free orders is never charged. Note that it will be your responsibility to claim the cancellation fee from the user."
msgstr "Solo afecta a reservas con pagos pendientes; nunca se cobra tarifa de cancelación para reservas gratuitas. Ten en cuenta que será tu responsabilidad reclamar la tarifa de cancelación al cliente."

msgid "Charge payment, shipping and service fees"
msgstr "Cobrar tarifas de pago, envío y servicio"

msgid "Charge a percentual cancellation fee"
msgstr "Cobrar una tarifa de cancelación porcentual"

msgid "Do not allow cancellations after"
msgstr "No permitir cancelaciones después de"

msgid "Customers can cancel their paid orders"
msgstr "Los clientes pueden cancelar sus reservas pagadas"

msgid "Paid money will be automatically paid back if the payment method allows it. Otherwise, a manual refund will be created for you to process manually."
msgstr "El dinero pagado será devuelto automáticamente si el método de pago lo permite. Si no, se creará un reembolso manual para que lo proceses manualmente."

msgid "Keep a fixed cancellation fee"
msgstr "Retener una tarifa de cancelación fija"

msgid "Keep payment, shipping and service fees"
msgstr "Retener tarifas de pago, envío y servicio"

msgid "Keep a percentual cancellation fee"
msgstr "Retener una tarifa de cancelación porcentual"

msgid "Allow customers to voluntarily choose a lower refund"
msgstr "Permitir que los clientes elijan voluntariamente un reembolso menor"

msgid "With this option enabled, your customers can choose to get a smaller refund to support you."
msgstr "Con esta opción activada, tus clientes pueden elegir recibir un reembolso menor para apoyarte."

msgid "However, if you want us to help keep the lights on here, please consider using the slider below to request a smaller refund. Thank you!"
msgstr "De todos modos, si quieres ayudarnos a mantener las luces encendidas aquí, puedes usar el control deslizante de abajo para solicitar un reembolso menor. ¡Gracias!"

msgid "Voluntary lower refund explanation"
msgstr "Explicación breve del reembolso inferior voluntario"

msgid "This text will be shown in between the explanation of how the refunds work and the slider which your customers can use to choose the amount they would like to receive. You can use it e.g. to explain choosing a lower refund will help your organization."
msgstr "Este texto se mostrará entre la explicación de cómo funcionan los reembolsos y el control deslizante que tus clientes pueden usar para elegir el importe que desean recibir. Puedes usarlo, por ejemplo, para explicar que elegir un reembolso más bajo ayudará a tu organización."

msgid "Step size for reduction amount"
msgstr "Tamaño del salto para el importe de reducción"

msgid "By default, customers can choose an arbitrary amount for you to keep. If you set this to e.g. 10, they will only be able to choose values in increments of 10."
msgstr "Por defecto, los clientes pueden elegir un importe cualquiera para que lo conserves. Si configuras esto en, por ejemplo, 10, solo podrán elegir valores en incrementos de 10."

msgid "Customers can only request a cancellation that needs to be approved by the event organizer before the order is canceled and a refund is issued."
msgstr "Los clientes solo pueden solicitar una cancelación que debe ser aprobada por el negocio antes de que se cancele la reserva y se emita un reembolso."

msgid "Do not show the cancellation fee to users when they request cancellation."
msgstr "No mostrar la tarifa de cancelación a los usuarios cuando soliciten la cancelación."

msgid "All refunds are issued to the original payment method"
msgstr "Todos los reembolsos se realizan con el método de pago original"

msgid "Customers can choose between a gift card and a refund to their payment method"
msgstr "Los clientes pueden elegir entre una tarjeta regalo y un reembolso a su método de pago"

msgid "All refunds are issued as gift cards"
msgstr "Todos los reembolsos se emiten como tarjetas regalo"

msgid "Do not handle refunds automatically at all"
msgstr "No gestionar los reembolsos automáticamente"

msgid "Refund method"
msgstr "Método de reembolso"

msgid "Terms of cancellation"
msgstr "Condiciones de cancelación"

msgid "This text will be shown when cancellation is allowed for a paid order. Leave empty if you want pretix to automatically generate the terms of cancellation based on your settings."
msgstr "Este texto se mostrará cuando se permita la cancelación de una reserva pagada. Déjalo vacío si quieres que pretix genere automáticamente las condiciones de cancelación según tu configuración."

msgid "This text will be shown when cancellation is allowed for an unpaid or free order. Leave empty if you want pretix to automatically generate the terms of cancellation based on your settings."
msgstr "Este texto se mostrará cuando se permita la cancelación de una reserva gratuita o no pagada. Déjalo vacío si quieres que pretix genere automáticamente las condiciones de cancelación según tu configuración."

msgid "Contact address"
msgstr "Dirección de contacto"

msgid "We'll show this publicly to allow attendees to contact you."
msgstr "Lo mostraremos públicamente para que los participantes puedan ponerse en contacto contigo."

msgid "Contact URL"
msgstr "URL de contacto"

msgid "If you set this, the footer contact link will point here instead of using the email address above. Please note that you still need to add a contact email address that will be shared with all emails you send."
msgstr "Si configuras esto, el enlace de contacto del pie de página redirigirá aquí en lugar de usar la dirección de correo electrónico de arriba. Ten en cuenta que aún necesitas añadir una dirección de correo electrónico de contacto que se incluirá en todos los correos que envíes."

msgid "Imprint URL"
msgstr "URL del pie de imprenta"

msgid "This should point e.g. to a part of your website that has your contact details and legal information."
msgstr "Esto debería apuntar, por ejemplo, a una parte de tu sitio web que tenga tus datos de contacto e información legal."

msgid "Privacy Policy URL"
msgstr "URL de la política de privacidad"

msgid "This should point e.g. to a part of your website that explains how you use data gathered in your ticket shop."
msgstr "Esto debería apuntar, por ejemplo, a una parte de tu sitio web que explica cómo usas los datos recogidos en tu página de reservas."

msgid "Accessibility information URL"
msgstr "URL de información sobre accesibilidad"

msgid "This should point e.g. to a part of your website that explains how your ticket shop complies with accessibility regulation."
msgstr "Esto debería apuntar, por ejemplo, a una parte de tu sitio web que explique cómo tu página de reservas cumple la normativa sobre accesibilidad."

msgid "Accessibility information"
msgstr "Información sobre accesibilidad"

msgid "Accessibility information title"
msgstr "Título de la información sobre accesibilidad"

msgid "Accessibility information text"
msgstr "Texto de la información sobre accesibilidad"

msgid "Attach ticket files"
msgstr "Adjuntar archivos de plazas"

msgid "Tickets will never be attached if they're larger than {size} to avoid email delivery problems."
msgstr "Nunca se adjuntarán plazas si son más grandes que {size} para evitar problemas de entrega de correo electrónico."

msgid "Attach calendar files"
msgstr "Adjuntar archivos de calendario"

msgid "If enabled, we will attach an .ics calendar file to order confirmation emails."
msgstr "Si está activado, adjuntaremos un archivo de calendario .ics a los correos electrónicos de confirmación de reserva."

msgid "Attach calendar files only after order has been paid"
msgstr "Adjuntar archivos de calendario solo después de que se haya pagado la reserva"

msgid "Use this if you e.g. put a private access link into the calendar file to make sure people only receive it after their payment was confirmed."
msgstr "Usa esto si, por ejemplo, incluyes un enlace de acceso privado en el archivo de calendario para asegurarte de que las personas solo lo reciban después de que se haya confirmado su pago."

msgid "Event description"
msgstr "Descripción del evento"

msgid "You can use this to share information with your attendees, such as travel information or the link to a digital event. If you keep it empty, we will put a link to the event shop, the admission time, and your organizer name in there. We do not allow using placeholders with sensitive person-specific data as calendar entries are often shared with an unspecified number of people."
msgstr "Puedes usar esto para compartir información con tus participantes, como información de viaje o el enlace a un evento digital. Si lo dejas vacío, incluiremos un enlace a la página de reservas, la hora de acceso y el nombre de tu negocio. No se permite usar variables con datos confidenciales específicos de una persona, ya que las entradas del calendario a menudo se comparten con un número no especificado de personas."

msgid "Subject prefix"
msgstr "Prefijo del asunto"

msgid "This will be prepended to the subject of all outgoing emails, formatted as [prefix]. Choose, for example, a short form of your event name."
msgstr "Esto se añadirá al asunto de todos los correos electrónicos salientes, formateado como [prefijo]. Elige, por ejemplo, una forma breve del nombre de tu evento."

msgid "Sender address"
msgstr "Dirección del remitente"

msgid "Sender address for outgoing emails"
msgstr "Dirección del remitente para correos electrónicos salientes"

msgid "Sender name"
msgstr "Nombre del remitente"

msgid "Sender name used in conjunction with the sender address for outgoing emails. Defaults to your event name."
msgstr "Nombre del remitente usado junto con la dirección del remitente para correos electrónicos salientes. Por defecto es el nombre de tu evento."

msgid "Your order: {code}"
msgstr "Tu reserva: {code}"

msgid "Your event registration: {code}"
msgstr "Tu registro al evento: {code}"

msgid "Hello,\n\nyou receive this message because you asked us to send you the link\nto your order for {event}.\n\nYou can change your order details and view the status of your order at\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola,\n\nrecibes este mensaje porque nos pediste que te enviáramos el enlace\nde tu reserva para {event}.\n\nPuedes cambiar los detalles de tu reserva y ver su estado en\n{url}\n\nSaludos,  \nTu equipo de {event}"

msgid "Your orders for {event}"
msgstr "Tus reservas para {event}"

msgid "Hello,\n\nsomebody requested a list of your orders for {event}.\nThe list is as follows:\n\n{orders}\n\nBest regards,  \nYour {event} team"
msgstr "Hola,\n\nalguien solicitó una lista de tus reservas para {event}.\nLa lista es la siguiente:\n\n{orders}\n\nSaludos,  \nTu equipo de {event}"

msgid "Hello {attendee_name},\n\nyou have been registered for {event} successfully.\n\nYou can view the details and status of your ticket here:\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola {attendee_name},\n\nte has registrado correctamente para {event}.\n\nPuedes ver los detalles y el estado de tu plaza aquí:\n{url}\n\nSaludos,  \nTu equipo de {event}"

msgid "Hello,\n\nyour order for {event} was successful. As you only ordered free products,\nno payment is required.\n\nYou can change your order details and view the status of your order at\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola,\n\ntu reserva para {event} se ha completado correctamente. Como solo reservaste servicios gratuitos,\nno se requiere ningún pago.\n\nPuedes cambiar los detalles de tu reserva y ver su estado en\n{url}\n\nSaludos,  \nTu equipo de {event}"

msgid "Hello,\n\nwe successfully received your order for {event}. Since you ordered\na product that requires approval by the event organizer, we ask you to\nbe patient and wait for our next email.\n\nYou can change your order details and view the status of your order at\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola,\n\nhemos recibido correctamente tu reserva para {event}. Como reservaste\nun servicio que requiere aprobación del negocio, te pedimos que\ntengas un poco de paciencia y esperes nuestro próximo correo.\n\nPuedes cambiar los detalles de tu reserva y ver su estado en\n{url}\n\nSaludos,  \nTu equipo de {event}"

msgid "Hello,\n\nwe successfully received your order for {event} with a total value\nof {total_with_currency}. Please complete your payment before {expire_date}.\n\n{payment_info}\n\nYou can change your order details and view the status of your order at\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola,\n\nhemos recibido correctamente tu reserva para {event} con un valor total\nde {total_with_currency}. Por favor, completa tu pago antes del {expire_date}.\n\n{payment_info}\n\nPuedes cambiar los detalles de tu reserva y ver su estado en\n{url}\n\nSaludos,  \nTu equipo de {event}"

msgid "Attachment for new orders"
msgstr "Adjunto para nuevas reservas"

msgid "This file will be attached to the first email that we send for every new order. Therefore it will be combined with the \"Placed order\", \"Free order\", or \"Received order\" texts from above. It will be sent to both order contacts and attendees. You can use this e.g. to send your terms of service. Do not use it to send non-public information as this file might be sent before payment is confirmed or the order is approved. To avoid this vital email going to spam, you can only upload PDF files of up to {size} MB."
msgstr "Este archivo se adjuntará al primer correo electrónico que enviemos por cada nueva reserva. Por lo tanto, se combinará con los textos de \"Reserva realizada\", \"Reserva gratuita\" o \"Reserva recibida\" de arriba. Se enviará tanto a los contactos de la reserva como a los participantes. Puedes usar esto, por ejemplo, para enviar tus condiciones de servicio. No lo uses para enviar información no pública, ya que este archivo podría enviarse antes de que se confirme el pago o se apruebe la reserva. Para evitar que este correo electrónico vital vaya a spam, solo puedes subir archivos PDF de hasta {size} MB."

msgid "Hello {attendee_name},\n\na ticket for {event} has been ordered for you.\n\nYou can view the details and status of your ticket here:\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola {attendee_name},\n\nse ha reservado una plaza de {event} para ti.\n\nPuedes ver los detalles y el estado de tu plaza aquí:\n{url}\n\nSaludos,  \nTu equipo de {event}"

msgid "Your order has been changed: {code}"
msgstr "Tu reserva ha sido modificada: {code}"

msgid "Hello,\n\nyour order for {event} has been changed.\n\nYou can view the status of your order at\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola,\n\ntu reserva para {event} ha sido modificada.\n\nPuedes ver el estado de tu reserva en\n{url}\n\nSaludos,  \nTu equipo de {event}"

msgid "Payment received for your order: {code}"
msgstr "Pago recibido por tu reserva: {code}"

msgid "Hello,\n\nwe successfully received your payment for {event}. Thank you!\n\n{payment_info}\n\nYou can change your order details and view the status of your order at\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola,\n\nhemos recibido correctamente tu pago por {event}. ¡Gracias!\n\n{payment_info}\n\nPuedes cambiar los detalles de tu reserva y ver su estado en\n{url}\n\nSaludos,  \nTu equipo de {event}"

msgid "Event registration confirmed: {code}"
msgstr "Registro al evento confirmado: {code}"

msgid "Hello {attendee_name},\n\na ticket for {event} that has been ordered for you is now paid.\n\nYou can view the details and status of your ticket here:\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola {attendee_name},\n\nla plaza de {event} reservada para ti ya está pagada.\n\nPuedes ver los detalles y el estado de tu plaza aquí:\n{url}\n\nSaludos,  \nTu equipo de {event}"

msgid "Number of days"
msgstr "Número de días"

msgid "This email will be sent out this many days before the order expires. If the value is 0, the mail will never be sent."
msgstr "Este correo se enviará tantos días antes de que caduque la reserva. Si el valor es 0, el correo nunca se enviará."

msgid "Your order is about to expire: {code}"
msgstr "Tu reserva está a punto de caducar: {code}"

msgid "Hello,\n\nwe did not yet receive a full payment for your order for {event}.\nPlease keep in mind that we only guarantee your order if we receive\nyour payment before {expire_date}.\n\nYou can view the payment information and the status of your order at\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola:\n\nTodavía no hemos recibido el pago completo de tu reserva para {event}.\nRecuerda que solo garantizamos tu reserva si recibimos\ntu pago antes del {expire_date}.\n\nPuedes ver la información de pago y el estado de tu reserva en\n{url}\n\nSaludos,\nEl equipo de {event}"

msgid "Your order is pending payment: {code}"
msgstr "Tu reserva está pendiente de pago: {code}"

msgid "Hello,\n\nwe did not yet receive a full payment for your order for {event}.\nPlease keep in mind that you are required to pay before {expire_date}.\n\nYou can view the payment information and the status of your order at\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola:\n\nTodavía no hemos recibido el pago completo de tu reserva para {event}.\nRecuerda que debes pagar antes del {expire_date}.\n\nPuedes ver la información de pago y el estado de tu reserva en\n{url}\n\nSaludos,\nEl equipo de {event}"

msgid "Incomplete payment received: {code}"
msgstr "Pago incompleto recibido: {code}"

msgid "Hello,\n\nwe received a payment for your order for {event}.\n\nUnfortunately, the received amount is less than the full amount\nrequired. Your order is therefore still considered unpaid, as it is\nmissing additional payment of **{pending_sum}**.\n\nYou can view the payment information and the status of your order at\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola:\n\nHemos recibido un pago de tu reserva para {event}.\n\nDesafortunadamente, el importe recibido es inferior al importe total\nnecesario. Por lo tanto, tu reserva todavía se considera impagada,\nya que falta un pago adicional de **{pending_sum}**.\n\nPuedes ver la información de pago y el estado de tu reserva en\n{url}\n\nSaludos,\nEl equipo de {event}"

msgid "Payment failed for your order: {code}"
msgstr "Error en el pago de tu reserva: {code}"

msgid "Hello,\n\nyour payment attempt for your order for {event} has failed.\n\nYour order is still valid and you can try to pay again using the same or a different payment method. Please complete your payment before {expire_date}.\n\nYou can retry the payment and view the status of your order at\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola:\n\nTu intento de pago de tu reserva para {event} ha fallado.\n\nTu reserva sigue siendo válida y puedes intentar pagar de nuevo usando el mismo método u otro diferente. Por favor, completa tu pago antes del {expire_date}.\n\nPuedes reintentar el pago y ver el estado de tu reserva en\n{url}\n\nSaludos,\nEl equipo de {event}"

msgid "You have been selected from the waitinglist for {event}"
msgstr "Has sido seleccionado de la lista de espera para {event}"

msgid "Hello,\n\nyou submitted yourself to the waiting list for {event},\nfor the product {product}.\n\nWe now have a ticket ready for you! You can redeem it in our ticket shop\nwithin the next {hours} hours by entering the following voucher code:\n\n{code}\n\nAlternatively, you can just click on the following link:\n\n{url}\n\nPlease note that this link is only valid within the next {hours} hours!\nWe will reassign the ticket to the next person on the list if you do not\nredeem the voucher within that timeframe.\n\nIf you do NOT need a ticket any more, we kindly ask you to click the\nfollowing link to let us know. This way, we can send the ticket as quickly\nas possible to the next person on the waiting list:\n\n{url_remove}\n\nBest regards,  \nYour {event} team"
msgstr "Hola:\n\nTe inscribiste en la lista de espera para {event},\npara el servicio {product}.\n\n¡Ya tenemos una plaza lista para ti! Puedes canjearla en nuestra página de reservas\ndentro de las próximas {hours} horas introduciendo el siguiente código:\n\n{code}\n\nO también puedes hacer clic en el siguiente enlace:\n\n{url}\n\n¡Ten en cuenta que este enlace solo es válido durante las próximas {hours} horas!\nReasignaremos la plaza a la siguiente persona de la lista si no\ncanjeas el código dentro de ese plazo.\n\nSi ya NO necesitas una plaza, te rogamos que hagas clic en el\nsiguiente enlace para avisarnos. Así podremos enviar la plaza lo antes\nposible a la siguiente persona de la lista de espera:\n\n{url_remove}\n\nSaludos,\nEl equipo de {event}"

msgid "Order canceled: {code}"
msgstr "Reserva cancelada: {code}"

msgid "Hello,\n\nyour order {code} for {event} has been canceled.\n\n{comment}\n\nYou can view the details of your order at\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola:\n\nTu reserva {code} para {event} ha sido cancelada.\n\n{comment}\n\nPuedes ver los detalles de tu reserva en\n{url}\n\nSaludos,\nEl equipo de {event}"

msgid "Order approved and awaiting payment: {code}"
msgstr "Reserva aprobada y pendiente de pago: {code}"

msgid "Hello,\n\nwe approved your order for {event} and will be happy to welcome you\nat our event.\n\nPlease continue by paying for your order before {expire_date}.\n\nYou can select a payment method and perform the payment here:\n\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola:\n\nHemos aprobado tu reserva para {event} y estaremos encantados\nde recibirte en nuestro evento.\n\nPor favor, continúa pagando tu reserva antes del {expire_date}.\n\nPuedes seleccionar un método de pago y realizar el pago aquí:\n\n{url}\n\nSaludos,\nEl equipo de {event}"

msgid "Hello,\n\nwe approved a ticket ordered for you for {event}.\n\nYou can view the details and status of your ticket here:\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola:\n\nHemos aprobado una plaza reservada para ti en {event}.\n\nPuedes ver los detalles y el estado de tu plaza aquí:\n{url}\n\nSaludos,\nEl equipo de {event}"

msgid "Order approved and confirmed: {code}"
msgstr "Reserva aprobada y confirmada: {code}"

msgid "Hello,\n\nwe approved your order for {event} and will be happy to welcome you\nat our event. As you only ordered free products, no payment is required.\n\nYou can change your order details and view the status of your order at\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola:\n\nHemos aprobado tu reserva para {event} y estaremos encantados de recibirte\nen nuestro evento. Como solo has reservado servicios gratuitos, no se requiere ningún pago.\n\nPuedes cambiar los detalles de tu reserva y ver el estado en\n{url}\n\nSaludos,\nEl equipo de {event}"

msgid "Order denied: {code}"
msgstr "Reserva denegada: {code}"

msgid "Hello,\n\nunfortunately, we denied your order request for {event}.\n\n{comment}\n\nYou can view the details of your order here:\n\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola:\n\nDesafortunadamente, hemos denegado tu solicitud de reserva para {event}.\n\n{comment}\n\nPuedes ver los detalles de tu reserva aquí:\n\n{url}\n\nSaludos,\nEl equipo de {event}"

msgid "Hello,\n\nYou can change your order details and view the status of your order at\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola:\n\nPuedes cambiar los detalles de tu reserva y ver el estado en\n{url}\n\nSaludos,\nEl equipo de {event}"

msgid "Invoice {invoice_number}"
msgstr "Factura {invoice_number}"

msgid "Hello,\n\nplease find attached a new invoice for order {code} for {event}. This order has been placed by {order_email}.\n\nBest regards,  \n\nYour {event} team"
msgstr "Hola:\n\nAdjunto encontrarás una nueva factura para la reserva {code} de {event}. Esta reserva ha sido realizada por {order_email}.\n\nSaludos,\n\nEl equipo de {event}"

msgid "Your ticket is ready for download: {code}"
msgstr "Tu plaza está lista para descargar: {code}"

msgid "Hello {attendee_name},\n\nyou are registered for {event}.\n\nIf you did not do so already, you can download your ticket here:\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola, {attendee_name}:\n\nEstás registrado en {event}.\n\nSi aún no lo has hecho, puedes descargar tu plaza aquí:\n{url}\n\nSaludos,\nEl equipo de {event}"

msgid "Hello,\n\nyou bought a ticket for {event}.\n\nIf you did not do so already, you can download your ticket here:\n{url}\n\nBest regards,  \nYour {event} team"
msgstr "Hola:\n\nHas reservado una plaza para {event}.\n\nSi aún no lo has hecho, puedes descargarla aquí:\n{url}\n\nSaludos,\nEl equipo de {event}"

msgid "Activate your account at {organizer}"
msgstr "Activa tu cuenta en {organizer}"

msgid "Hello {name},\n\nthank you for signing up for an account at {organizer}!\n\nTo activate your account and set a password, please click here:\n\n{url}\n\nThis link is valid for one day.\n\nIf you did not sign up yourself, please ignore this email.\n\nBest regards,  \n\nYour {organizer} team"
msgstr "Hola, {name}:\n\n¡Gracias por registrarte en {organizer}!\n\nPara activar tu cuenta y establecer una contraseña, haz clic aquí:\n\n{url}\n\nEste enlace es válido durante un día.\n\nSi no te has registrado tú, ignora este correo.\n\nSaludos,\n\nEl equipo de {organizer}"

msgid "Confirm email address for your account at {organizer}"
msgstr "Confirma la dirección de correo electrónico de tu cuenta en {organizer}"

msgid "Hello {name},\n\nyou requested to change the email address of your account at {organizer}!\n\nTo confirm the change, please click here:\n\n{url}\n\nThis link is valid for one day.\n\nIf you did not request this, please ignore this email.\n\nBest regards,  \n\nYour {organizer} team"
msgstr "Hola, {name}:\n\nHas solicitado cambiar la dirección de correo electrónico de tu cuenta en {organizer}.\n\nPara confirmar el cambio, haz clic aquí:\n\n{url}\n\nEste enlace es válido durante un día.\n\nSi no has solicitado esto, ignora este correo.\n\nSaludos,\n\nEl equipo de {organizer}"

msgid "Set a new password for your account at {organizer}"
msgstr "Establece una nueva contraseña para tu cuenta en {organizer}"

msgid "Hello {name},\n\nyou requested a new password for your account at {organizer}!\n\nTo set a new password, please click here:\n\n{url}\n\nThis link is valid for one day.\n\nIf you did not request a new password, please ignore this email.\n\nBest regards,  \n\nYour {organizer} team"
msgstr "Hola, {name}:\n\nHas solicitado una nueva contraseña para tu cuenta en {organizer}.\n\nPara establecer una nueva contraseña, haz clic aquí:\n\n{url}\n\nEste enlace es válido durante un día.\n\nSi no has solicitado una nueva contraseña, ignora este correo.\n\nSaludos,\n\nEl equipo de {organizer}"

msgid "Changes to your account at {organizer}"
msgstr "Cambios en tu cuenta en {organizer}"

msgid "Hello {name},\n\nthe following change has been made to your account at {organizer}:\n\n{message}\n\nYou can review and change your account settings here:\n\n{url}\n\nIf this change was not performed by you, please contact us immediately.\n\nBest regards,  \n\nYour {organizer} team"
msgstr "Hola, {name}:\n\nSe ha realizado el siguiente cambio en tu cuenta de {organizer}:\n\n{message}\n\nPuedes revisar y cambiar la configuración de tu cuenta aquí:\n\n{url}\n\nSi no has realizado este cambio, contacta con nosotros inmediatamente.\n\nSaludos,\n\nEl equipo de {organizer}"

msgid "Please enter the hexadecimal code of a color, e.g. #990000."
msgstr "Introduce el código hexadecimal de un color, por ejemplo, #990000."

msgid "Primary color"
msgstr "Color primario"

msgid "Accent color for success"
msgstr "Color de énfasis para éxito"

msgid "We strongly suggest to use a shade of green."
msgstr "Recomendamos usar un tono de verde."

msgid "Accent color for errors"
msgstr "Color de énfasis para errores"

msgid "We strongly suggest to use a shade of red."
msgstr "Recomendamos usar un tono de rojo."

msgid "Page background color"
msgstr "Color de fondo de la página"

msgid "Use round edges"
msgstr "Usar bordes redondeados"

msgid "Use native spinners in the widget instead of custom ones for numeric inputs such as quantity."
msgstr "Usar controles numéricos nativos en el widget en lugar de personalizados para entradas numéricas como la cantidad."

msgid "Only respected by modern browsers."
msgstr "Solo compatible con navegadores modernos."

msgid "Header image"
msgstr "Imagen de cabecera"

msgid "If you provide a logo image, we will by default not show your event name and date in the page header. If you use a white background, we show your logo with a size of up to 1140x120 pixels. Otherwise the maximum size is 1120x120 pixels. You can increase the size with the setting below. We recommend not using small details on the picture as it will be resized on smaller screens."
msgstr "Si subes una imagen de logo, por defecto no mostraremos el nombre del evento ni la fecha en la cabecera de la página. Si usas un fondo blanco, mostramos tu logo con un tamaño de hasta 1140x120 píxeles. De lo contrario, el tamaño máximo es 1120x120 píxeles. Puedes aumentar el tamaño con la configuración siguiente. Recomendamos no usar detalles pequeños en la imagen, ya que se redimensionará en pantallas más pequeñas."

msgid "Use header image in its full size"
msgstr "Usar la imagen de cabecera en su tamaño completo"

msgid "We recommend to upload a picture at least 1170 pixels wide."
msgstr "Recomendamos subir una imagen de al menos 1170 píxeles de ancho."

msgid "Show event title even if a header image is present"
msgstr "Mostrar el título del evento aunque haya una imagen de cabecera"

msgid "The title will only be shown on the event front page. If no header image is uploaded for the event, but the header image from the organizer profile is used, this option will be ignored and the event title will always be shown."
msgstr "El título solo se mostrará en la portada del evento. Si no se sube ninguna imagen de cabecera para el evento pero se usa la imagen del perfil del negocio, esta opción se ignorará y siempre se mostrará el título del evento."

msgid "If you provide a logo image, we will by default not show your organization name in the page header. If you use a white background, we show your logo with a size of up to 1140x120 pixels. Otherwise the maximum size is 1120x120 pixels. You can increase the size with the setting below. We recommend not using small details on the picture as it will be resized on smaller screens."
msgstr "Si subes una imagen de logo, por defecto no mostraremos el nombre del negocio en la cabecera de la página. Si usas un fondo blanco, mostramos tu logo con un tamaño de hasta 1140x120 píxeles. De lo contrario, el tamaño máximo es 1120x120 píxeles. Puedes aumentar el tamaño con la configuración siguiente. Recomendamos no usar detalles pequeños en la imagen, ya que se redimensionará en pantallas más pequeñas."

msgid "Use header image also for events without an individually uploaded logo"
msgstr "Usar imagen de cabecera también para eventos sin un logo subido individualmente"

msgid "Favicon"
msgstr "Favicon"

msgid "If you provide a favicon, we will show it instead of the default pretix icon. We recommend a size of at least 200x200px to accommodate most devices."
msgstr "Si subes un favicon, lo mostraremos en lugar del icono predeterminado de pretix. Recomendamos un tamaño de al menos 200x200 píxeles para adaptarse a la mayoría de dispositivos."

msgid "Social media image"
msgstr "Imagen para redes sociales"

msgid "This picture will be used as a preview if you post links to your ticket shop on social media. Facebook advises to use a picture size of 1200 x 630 pixels, however some platforms like WhatsApp and Reddit only show a square preview, so we recommend to make sure it still looks good if only the center square is shown. If you do not fill this, we will use the logo given above."
msgstr "Esta imagen se utilizará como vista previa si publicas enlaces a tu página de reservas en redes sociales. Facebook recomienda usar un tamaño de 1200 x 630 píxeles; sin embargo, algunas plataformas como WhatsApp y Reddit solo muestran una vista previa cuadrada, por lo que recomendamos asegurarse de que se vea bien si solo se muestra el cuadrado central. Si no la rellenas, usaremos el logo indicado arriba."

msgid "Logo image"
msgstr "Imagen del logo"

msgid "We will show your logo with a maximal height and width of 2.5 cm."
msgstr "Mostraremos tu logo con una altura y anchura máxima de 2,5 cm."

msgid "Info text"
msgstr "Texto informativo"

msgid "Not displayed anywhere by default, but if you want to, you can use this e.g. in ticket templates."
msgstr "No se muestra en ninguna parte de forma predeterminada, pero si quieres puedes usarlo, por ejemplo, en las plantillas de plazas."

msgid "Banner text (top)"
msgstr "Texto del banner (arriba)"

msgid "This text will be shown above every page of your shop. Please only use this for very important messages."
msgstr "Este texto se mostrará encima de cada página de tu página de reservas. Usa esto únicamente para mensajes muy importantes."

msgid "Banner text (bottom)"
msgstr "Texto del banner (abajo)"

msgid "This text will be shown below every page of your shop. Please only use this for very important messages."
msgstr "Este texto se mostrará debajo de cada página de tu página de reservas. Usa esto únicamente para mensajes muy importantes."

msgid "Voucher explanation"
msgstr "Explicación del código"

msgid "This text will be shown next to the input for a voucher code. You can use it e.g. to explain how to obtain a voucher code."
msgstr "Este texto se mostrará junto al campo para introducir un código. Puedes usarlo, por ejemplo, para explicar cómo obtener un código."

msgid "Attendee data explanation"
msgstr "Explicación de los datos de participantes"

msgid "This text will be shown above the questions asked for every personalized product. You can use it e.g. to explain why you need information from them."
msgstr "Este texto se mostrará encima de las preguntas formuladas para cada servicio personalizado. Puedes usarlo, por ejemplo, para explicar por qué se necesita información de los participantes."

msgid "Additional success message"
msgstr "Mensaje de éxito adicional"

msgid "This message will be shown after an order has been created successfully. It will be shown in additional to the default text."
msgstr "Este mensaje se mostrará después de que una reserva se haya creado correctamente. Se mostrará además del texto predeterminado."

msgid "Help text of the phone number field"
msgstr "Texto de ayuda del campo del número de teléfono"

msgid "Make sure to enter a valid email address. We will send you an order confirmation including a link that you need to access your order later."
msgstr "Asegúrate de introducir una dirección de correo electrónico válida. Se enviará una confirmación de la reserva con un enlace para acceder a ella más adelante."

msgid "Help text of the email field"
msgstr "Texto de ayuda del campo de correo electrónico"

msgid "Allow creating a new team during event creation"
msgstr "Permitir crear un nuevo equipo durante la creación de la agenda"

msgid "Users that do not have access to all events under this organizer, must select one of their teams to have access to the created event. This setting allows users to create an event-specified team on-the-fly, even when they do not have \"Can change teams and permissions\" permission."
msgstr "Los usuarios que no tengan acceso a todas las agendas de este negocio deben seleccionar uno de sus equipos para tener acceso a la agenda creada. Esta configuración permite crear un equipo específico sobre la marcha, incluso sin el permiso \"Puede cambiar equipos y permisos\"."

msgid "Event start time (descending)"
msgstr "Hora de inicio de agenda (descendente)"

msgid "Name (descending)"
msgstr "Nombre (descendente)"

msgctxt "subevent"
msgid "Date ordering"
msgstr "Ordenación por fecha"

msgid "Link back to organizer overview on all event pages"
msgstr "Enlace de vuelta a la vista general del negocio en todas las páginas de agenda"

msgid "Homepage text"
msgstr "Texto de la página de inicio"

msgid "This will be displayed on the organizer homepage."
msgstr "Esto se mostrará en la página de inicio del negocio."

msgid "Length of gift card codes"
msgstr "Longitud de los códigos de tarjetas regalo"

msgid "The system generates by default {}-character long gift card codes. However, if a different length is required, it can be set here."
msgstr "El sistema genera de forma predeterminada códigos de tarjetas regalo de {} caracteres de longitud. Si se requiere una longitud diferente, se puede configurar aquí."

msgid "Validity of gift card codes in years"
msgstr "Validez de los códigos de tarjetas regalo en años"

msgid "If you set a number here, gift cards will by default expire at the end of the year after this many years. If you keep it empty, gift cards do not have an explicit expiry date."
msgstr "Si se establece un número aquí, las tarjetas regalo caducarán de forma predeterminada al final del año después de tantos años. Si se deja vacío, las tarjetas regalo no tienen una fecha de caducidad explícita."

msgid "Enable cookie consent management features"
msgstr "Habilitar funciones de gestión de consentimiento de cookies"

msgid "By clicking \"Accept all cookies\", you agree to the storing of cookies and use of similar technologies on your device."
msgstr "Al hacer clic en \"Aceptar todas las cookies\", aceptas el almacenamiento de cookies y el uso de tecnologías similares en tu dispositivo."

msgid "Dialog text"
msgstr "Texto de diálogo"

msgid "We use cookies and similar technologies to gather data that allows us to improve this website and our offerings. If you do not agree, we will only use cookies if they are essential to providing the services this website offers."
msgstr "Utilizamos cookies y tecnologías similares para recopilar datos que nos permiten mejorar este sitio web y nuestras ofertas. Si no estás de acuerdo, solo usaremos cookies si son esenciales para proporcionar los servicios que ofrece este sitio web."

msgid "Secondary dialog text"
msgstr "Texto secundario de diálogo"

msgid "Privacy settings"
msgstr "Configuración de privacidad"

msgid "Dialog title"
msgstr "Título del diálogo"

msgid "Accept all cookies"
msgstr "Aceptar todas las cookies"

msgid "\"Accept\" button description"
msgstr "Descripción del botón \"Aceptar\""

msgid "Required cookies only"
msgstr "Solo cookies requeridas"

msgid "\"Reject\" button description"
msgstr "Descripción del botón \"Rechazar\""

msgid "Customers can choose their own seats"
msgstr "Los clientes pueden elegir sus propios asientos"

msgid "If disabled, you will need to manually assign seats in the backend. Note that this can mean people will not know their seat after their purchase and it might not be written on their ticket."
msgstr "Si está deshabilitado, será necesario asignar asientos manualmente en el panel. Ten en cuenta que esto puede significar que los clientes no conocerán su asiento después de reservar y puede que no aparezca en su plaza."

msgid "Show button to copy user input from other products"
msgstr "Mostrar botón para copiar datos de otros servicios"

msgid "Most common English titles"
msgstr "Títulos en inglés más comunes"

msgid "Most common German titles"
msgstr "Títulos en alemán más comunes"

