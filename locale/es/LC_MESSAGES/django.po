msgstr "Sistema de autenticación"

msgid "Reset drift and throttle"
msgstr "Restablecer drift and throttle"

msgid "Available two-factor authentication methods"
msgstr "Métodos de autenticación de dos factores disponibles"

msgid "1 failed attempt since %(date)s"
msgid_plural "%(cnt)s failed attempts since %(date)s"
msgstr[0] "1 intento fallido desde el %(date)s"
msgstr[1] "%(cnt)s intentos fallidos desde el %(date)s"

msgid "Currently locked until %(date)s"
msgstr "Bloqueado hasta el %(date)s"

